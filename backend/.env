# SYNAPS_STORAGE_PATH=/storage
SYNAPS_STORAGE_PATH=/Users/harsh_rathod/Desktop/nas_dashboard/iphone

# Database location
# SYNAPS_DB_URL=sqlite:///path/to/synaps.db

